# Copied to .env on first run (run_all.py). .env is git-ignored; this example file holds NO real secrets.
# Configs only ever reference values here as ${NAME}; on first use secrets are encrypted into the vault.

# ======================= REAL free-tier sources (leave empty -> the card shows "Not configured") =======================
# GitHub REST API: fine-grained personal access token, read-only (Metadata + Dependabot alerts: read)
github_token=
GITHUB_OWNER=
GITHUB_REPO=
# optional: list org members instead of only repo collaborators
GITHUB_ORG=

# Okta Integrator Free Plan: API token (Security > API > Tokens), created by a read-only admin
okta_token=
# e.g. integrator-1234567.okta.com
OKTA_DOMAIN=

# Jira Cloud free plan: Atlassian account email + API token (id.atlassian.com > Security > API tokens)
jira_email=
jira_token=
# e.g. yourteam.atlassian.net
JIRA_DOMAIN=

# NVD CVE API 2.0: optional key (works without one, at a lower rate limit)
nvd_api_key=

# ======================= Alert on repeated failure (B-4) - all optional =======================
# Offline demo default = mock Slack inbox (http://localhost:9004/slack). Put your real webhook in .env only.
SLACK_WEBHOOK_URL=http://localhost:9004/slack/webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ======================= Mock tools (public demo values, not real secrets) =======================
MOCK_CLOUDTRAIL_TOKEN=ct-demo-token-5e2b7d
MOCK_FIREWALL_API_KEY=fw-demo-key-2b8e41
MOCK_OKTA_CLIENT_ID=0oa-demo-client
MOCK_OKTA_CLIENT_SECRET=okta-demo-secret-8c41
MOCK_JIRA_USER=soc-bot@mitigata.local
MOCK_JIRA_TOKEN=jira-demo-token-91d2

# Demo mode: random faults OFF, so the presenter triggers them on cue from Settings -> Demo controls.
# Set DEMO_MODE=off for "live chaos": ~1 in 5 firewall requests get HTTP 429, ~1 in 15 records are malformed.
DEMO_MODE=on
# Optional explicit overrides (on|off); empty = follow DEMO_MODE
FIREWALL_RATE_LIMIT=
MALFORMED_RECORDS=

# ======================= Token safety =======================
# Master key for the encrypted secret vault. Leave empty: run_all.py generates one on first run.
SECRETS_KEY=
# Demo only: make a seeded secret look old so health shows "Rotate secret" (NAME:days, comma-separated)
SECRET_AGE_OVERRIDES=MOCK_FIREWALL_API_KEY:95

# ======================= Ports =======================
PLATFORM_PORT=8000
MOCK_CLOUDTRAIL_PORT=9001
MOCK_FIREWALL_PORT=9002
MOCK_OKTA_PORT=9003
MOCK_JIRA_PORT=9004

# ======================= Optional LLM for the AI mapping assistant (empty = offline rule-based fallback) =======================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ...or any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
